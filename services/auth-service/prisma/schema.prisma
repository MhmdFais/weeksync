generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["identity", "reports"]
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("member")
  createdAt    DateTime @default(now())

  @@schema("identity")
}

model Report {
  id        Int      @id @default(autoincrement())
  title     String
  createdAt DateTime @default(now())

  @@schema("reports")
}